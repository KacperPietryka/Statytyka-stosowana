   "source": [
    "import scipy as sp\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b73bfeb1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def norm_xd(u, Q, N):\n",
    "    L = np.linalg.cholesky(Q)\n",
    "    tab = []\n",
    "    for _ in range(N):\n",
    "        v = sp.stats.norm.rvs(size=Q.shape[0])\n",
    "        tab.append(((L @ v) + u).A[0])\n",
    "    return tab"
   ]
  }
 ],
